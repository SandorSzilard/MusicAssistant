{
  "name": "music-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first musician practice and live-performance assistant",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start": "npm run dev",
    "dev": "tauri dev",
    "run:app": "tauri dev",
    "frontend:dev": "ng serve --host 127.0.0.1 --port 4200",
    "frontend:build": "ng build",
    "build": "npm run frontend:build",
    "build:app": "tauri build --no-bundle",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "release:local": "npm run build:app && npm run package:portable",
    "package:portable": "node scripts/package-portable.mjs",
    "feedback": "node scripts/collect-feedback.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "essentia.js": "0.1.3",
    "rxjs": "~7.8.0",
    "signalsmith-stretch": "1.3.2",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@tauri-apps/cli": "2.12.4",
    "archiver": "7.0.1",
    "typescript": "~5.9.0"
  }
}
